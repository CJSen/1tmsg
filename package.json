{
  "name": "1tmsg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "阅后即焚秘密消息服务 · 端到端加密 · Cloudflare Workers + Durable Objects",
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-html.mjs",
    "dev": "node scripts/run.mjs --dev",
    "deploy": "node scripts/run.mjs",
    "locale": "node scripts/sync-locale.mjs",
    "typecheck": "node scripts/sync-locale.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
