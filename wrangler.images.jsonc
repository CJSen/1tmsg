// 1tmsg · 图片版：npm run deploy -- -c wrangler.images.jsonc
// 与 wrangler.jsonc 只差 r2_buckets 那段（这里生效），键顺序一致；不想绑卡就用那份。
// 前提：账号已开通 R2，并已建桶（桶名与下面的 bucket_name 一致）：
//   npx wrangler r2 bucket create 1tmsg-blobs
//   npx wrangler r2 bucket lifecycle add 1tmsg-blobs expire-old --expire-days 7
// 两份都随仓库入库、别 gitignore；自己的域名/桶名/邮箱另建 wrangler.<自定义>.jsonc（已被忽略）。
// 三段：① 固定头（不必改）② 常用配置（按需改）③ 机械配置（不用动）。标「代码耦合」的字段勿改名。
{
	// ① 固定头
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "1tmsg", // 同账号下需唯一，决定 *.workers.dev 前缀
	"main": "src/index.ts",
	"compatibility_date": "2025-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],

	// ② 常用配置
	"vars": {
		"DEFAULT_LOCALE": "zh", // "zh" | "en"，构建期生效；访客可手动切换
		"ABUSE_CONTACT": "", // 只认邮箱或 http(s) 网址；留空则页脚不显示举报入口（用途告知是内置的）
		"MAX_MESSAGE_BYTES": "10485760",
		"MAX_ATTACHMENT_BYTES": "10485760", // 单张图片上限；合计上限（50MB）硬编码在 src/config.ts
		"RATE_LIMIT_MAX_CREATES": "30", // 每 IP 每分钟创建上限；不能设 "0"（会回退默认值）
		"MAX_R2_STORAGE_GB": "5", // 桶可被消息预留的总量上限（GB，支持小数）；"0" = 不再收图片
		"INITIAL_RESERVED_GB": "0" // 仅升级已在跑的实例时填（取 R2 控制台当前用量）；只播一次
	},
	// 图片密文的对象存储 —— 有这一段就是「带图片的版本」。桶须保持私有（不配公开域名、
	// 不签发 presigned URL），否则密文可被无限次下载；换自己的桶名改 bucket_name。
	"r2_buckets": [
		{
			"binding": "BLOBS",
			"bucket_name": "1tmsg-blobs"
		}
	],
	// 自定义域名（域名须已托管在 Cloudflare；证书与 DNS 会自动创建）
	// "routes": [{ "pattern": "1tmsg.example.com", "custom_domain": true }],
	"workers_dev": true, // 上面的 routes 生效后本项会被默认关闭

	// ③ 机械配置
	"assets": {
		"directory": "./public",
		"binding": "ASSETS", // 代码耦合
		"not_found_handling": "none"
	},
	// 代码耦合：binding 名与 class_name 必须与 src/ 的导出一致
	"durable_objects": {
		"bindings": [
			{
				"name": "MESSAGE_BOX",
				"class_name": "MessageBox"
			},
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			},
			{
				"name": "STORAGE_GUARD", // 全局容量计数器，单例 'global'（见 src/config.ts）
				"class_name": "StorageGuard"
			}
		]
	},
	// 已有线上数据时不要回改本段；v2 只新增 StorageGuard，v1 不要动
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MessageBox",
				"RateLimiter"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"StorageGuard"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}
